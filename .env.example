# Token bot Telegram gửi cảnh báo người lạ
TELEGRAM_BOT_TOKEN=
# Định danh cuộc trò chuyện nhận cảnh báo
TELEGRAM_CHAT_ID=
# Mức log toàn hệ thống — DEBUG/INFO/WARNING/ERROR, mặc định INFO
FACEID_LOG_LEVEL=
# Đường dẫn file log, để trống thì chỉ ghi ra console
FACEID_LOG_FILE=
# Sao chép thành .env rồi điền giá trị thật; .env đã bị .gitignore chặn.
